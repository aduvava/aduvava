{
  "name": "Eduva temporary test",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/aduvava",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    3000,
    4000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Eduva test preview",
      "onAutoForward": "openPreview"
    },
    "4000": {
      "label": "Eduva admin preview",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-preview.sh",
  "postStartCommand": "bash .devcontainer/start-preview.sh"
}
