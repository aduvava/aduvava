# Copy to .env and replace the placeholders before starting.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/eduva?schema=public
POSTGRES_PASSWORD=replace-with-a-long-alphanumeric-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MOCK_PAYMENT_BASE_URL=http://localhost:4000
ADMIN_PORT=4000
ADMIN_HOST=127.0.0.1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional seed credentials; omitted passwords are random and not recoverable.
SEED_DEMO_EMAIL=student-demo@example.invalid
SEED_DEMO_PASSWORD=
SEED_TEACHER_EMAIL=teacher-demo@example.invalid
SEED_TEACHER_PASSWORD=
