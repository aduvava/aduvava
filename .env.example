# Copy to .env and paste the Session Pooler connection URI from Supabase.
# Keep this server-only; never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<session-pooler-host>:5432/postgres?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Required only when running `npm run db:seed` to provision an admin account
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# For standalone Admin behind an HTTPS reverse proxy, set the exact public origin.
# Example: ADMIN_PUBLIC_ORIGIN="https://admin.example.com"
ADMIN_PUBLIC_ORIGIN=""

# Security: persistent database-backed abuse prevention
# Optional separate HMAC secret; if empty, NEXTAUTH_SECRET is used (>=16 characters).
SECURITY_RATE_LIMIT_SECRET=""
# ONLY set true if a trusted reverse proxy strips and replaces client-provided
# X-Forwarded-For/X-Real-IP headers. Otherwise account/global buckets still work.
SECURITY_TRUST_PROXY_IP_HEADERS="false"

# Documents must be stored outside public/; Docker Compose uses /app/storage/documents.
# For bare-metal deployments, defaults to <project>/storage/documents.
DOCUMENT_STORAGE_DIR=""
# Production defaults to true; fail closed if ClamAV is not reachable.
# CI may explicitly set false with test-only sample files. Do not disable in public production.
DOCUMENT_SCAN_REQUIRED="true"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
